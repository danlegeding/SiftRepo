# 复制本文件为 .env 后再填自己的值：copy .env.example .env
# 注意：.env 已被 .gitignore 忽略；本文件会进仓库，所有 key 这里只留占位符。

# DeepSeek（代码问答 LLM）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 只有当你要接「代理/自定义模型」且它认 thinking 字段时才打开
#DEEPSEEK_DISABLE_THINKING=1

# CloseAI 代理（embedding + 代码分析用的 OpenAI 兼容接口）
CLOSEAI_API_KEY=sk-your-closeai-key
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1

# 向量模型与维度：换模型时两个都要一起改，并且要重建 embedding 列
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIM=1536
# 代码质量分析用的模型
ANALYSIS_MODEL=gpt-5.4-mini

# PostgreSQL（docker compose 里的 siftrepo-postgres，端口 5432）
# 不填时会回退到这个默认值并打印警告
DB_URL=postgres://user:12345@127.0.0.1:5432/siftrepo

# 聊天记录（docker compose 里的 siftrepo-milvus）
MILVUS_URI=http://127.0.0.1:19530

# LangSmith 监控（可选）
#LANGSMITH_TRACING=false
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=
